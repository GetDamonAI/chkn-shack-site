# Seasonal gate for THE TAILGATE CRATE (Football Season, Sep 1 – Feb 28).
# Defaults to on when unset. Set to "false" and redeploy to pull the crate card,
# its menu row, and its Product schema entry — no code change required.
NEXT_PUBLIC_TAILGATE_ACTIVE=true

# ── Analytics + ad pixels ────────────────────────────────────────────────────
# All three are public, client-side measurement IDs — they ship in the page
# source by design, so committing them here is safe. Each block in
# src/components/analytics/analytics.tsx is gated on its variable: unset the
# value to switch that pixel off without touching code.
NEXT_PUBLIC_GA4_ID=G-HKMV6C2T1G
NEXT_PUBLIC_META_PIXEL_ID=2307292793425807
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DAHQ48RC77UEK70HTCT0
